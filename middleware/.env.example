# --- Listener ---
PORT=3002

# Optional JSON parser cap for the middleware. Leave unset for the default
# unbounded parser behavior; nginx/SAP may still enforce their own limits.
# MIDDLEWARE_BODY_LIMIT=<size-if-you-intentionally-want-a-cap>


# --- Shared secret between Edge Function and middleware ---
# Must match SAP_MIDDLEWARE_KEY configured in Lovable Cloud secrets.
MIDDLEWARE_SHARED_SECRET=replace-with-a-long-random-string

# --- SAP Business Partner API ---
SAP_BP_API_URL=http://10.200.1.2:8000/vendor/bp/create?sap-client=300
# --- SAP DMS / Document upload API (defaults to SAP_BP_API_URL if unset) ---
SAP_DMS_API_URL=http://10.200.1.2:8000/vendor/bp/create?sap-client=300
SAP_BP_USERNAME=replace-with-sap-username
SAP_BP_PASSWORD=replace-with-sap-password

# --- Behavior ---
# Total time we wait for SAP to fully respond before aborting.
SAP_REQUEST_TIMEOUT_MS=30000

# TCP connect timeout for the SAP host. Node's built-in fetch (undici) has a
# 10s default which causes UND_ERR_CONNECT_TIMEOUT on slow networks even when
# Postman succeeds. Bump this if SAP is slow to accept TCP connections.
SAP_CONNECT_TIMEOUT_MS=60000

# Optional headers timeout (time waiting for SAP to send response headers).
SAP_HEADERS_TIMEOUT_MS=60000

# Optional body timeout (time between bytes once response starts).
SAP_BODY_TIMEOUT_MS=60000

# Comma-separated list of allowed CORS origins. Use * to allow any.
CORS_ORIGINS=*

# Set to "1" to allow self-signed / untrusted SAP TLS certificates.
ALLOW_INSECURE_TLS=0
